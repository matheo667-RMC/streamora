generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          String    @default("user")
  twoFactorSecret  String?
  twoFactorEnabled Boolean  @default(false)
  planTier      String    @default("free")   // free | month1 | month2 | month6 | lifetime
  planExpiresAt DateTime?
  badges        String    @default("")       // comma-separated custom badge labels
  watchSeconds  Int       @default(0)        // total watch time in seconds
  signupIp      String?
  signupDevice  String?
  accounts      Account[]
  sessions      Session[]
  profiles      Profile[]
  downloads     Download[]
  redeemedKeys  RedeemKey[]
  createdAt     DateTime  @default(now())
}

model RedeemKey {
  id         String    @id @default(cuid())
  code       String    @unique               // e.g. Streamora-A1B2C3D4
  planTier   String    @default("month1")    // month1 | month2 | month6 | lifetime
  durationDays Int     @default(30)          // 0 = lifetime
  used       Boolean   @default(false)
  usedById   String?
  usedBy     User?     @relation(fields: [usedById], references: [id], onDelete: SetNull)
  usedAt     DateTime?
  note       String    @default("")
  createdAt  DateTime  @default(now())
}

model Order {
  id          String   @id @default(cuid())
  userId      String
  planTier    String                          // month1 | month2 | month6 | lifetime
  priceEur    Float    @default(0)
  payCurrency String   @default("")           // btc | eth | usdttrc20 | ltc | trx | sol
  paymentId   String   @unique                // NOWPayments payment_id
  payAddress  String   @default("")
  payAmount   String   @default("")
  status      String   @default("waiting")    // NOWPayments status
  delivered   Boolean  @default(false)
  keyCode     String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Film {
  id          String     @id @default(cuid())
  title       String
  description String     @default("")
  category    String     @default("Autre")
  posterUrl   String     @default("")
  videoUrl    String     @default("")
  tmdbId      Int?
  trailerUrl  String     @default("")
  year        Int        @default(2024)
  duration    String     @default("")
  featured    Boolean    @default(false)
  downloads   Download[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Series {
  id          String    @id @default(cuid())
  title       String
  description String    @default("")
  category    String    @default("Autre")
  posterUrl   String    @default("")
  tmdbId      Int?
  year        Int       @default(2024)
  featured    Boolean   @default(false)
  episodes    Episode[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Episode {
  id        String   @id @default(cuid())
  seriesId  String
  season    Int      @default(1)
  number    Int      @default(1)
  title     String   @default("")
  videoUrl  String   @default("")
  duration  String   @default("")
  series    Series   @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Profile {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  avatarUrl String   @default("")
  downloads Download[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Download {
  id        String   @id @default(cuid())
  filmId    String
  userId    String
  profileId String?
  film      Film     @relation(fields: [filmId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile   Profile? @relation(fields: [profileId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
}

model LibraryItem {
  id        String   @id @default(cuid())
  userId    String
  mediaType String   // film | series
  mediaId   String
  status    String   // list | watched | later
  createdAt DateTime @default(now())

  @@unique([userId, mediaType, mediaId, status])
  @@index([userId, status])
}

model Rating {
  id        String   @id @default(cuid())
  userId    String
  mediaType String   // film | series
  mediaId   String
  stars     Int      @default(0) // 1..5
  review    String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, mediaType, mediaId])
  @@index([mediaType, mediaId])
}

model SiteSettings {
  id               String  @id @default("main")
  maintenanceMode  Boolean @default(false)
  maintenanceMsg   String  @default("Streamora est en maintenance. Nous revenons bientôt !")
  maintenanceStyle String  @default("classic")
  iptvAgentUrl     String  @default("")
  serverBaseUrl    String  @default("")
  serverSyncKey    String  @default("")   // lets the PC server publish its public URL by itself
  // Payment settings (admin-configurable)
  paypalEmail      String  @default("")
  telegramHandle   String  @default("")
  btcAddress       String  @default("")
  ethAddress       String  @default("")
  usdtAddress      String  @default("")
  ltcAddress       String  @default("")
  trxAddress       String  @default("")
  solAddress       String  @default("")
  priceMonth1      Float   @default(5)
  priceMonth2      Float   @default(8)
  priceMonth6      Float   @default(20)
  priceLifetime    Float   @default(99.99)
  paywallEnabled   Boolean @default(false)
  maxAccountsPerIp Int     @default(2)
  autoMaintenance  Boolean @default(false)   // weekly Sunday maintenance window
  lastMaintenanceAt DateTime?
}
