# Database (PostgreSQL - get a free one at https://neon.tech)
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-secret-with-openssl-rand-base64-32"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Admin email (this email will automatically get admin role)
ADMIN_EMAIL="your-admin-email@gmail.com"

# Payments (PayPal — money lands directly on your PayPal account)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_MODE=live
NEXT_PUBLIC_SITE_URL=https://streamora-films.vercel.app
